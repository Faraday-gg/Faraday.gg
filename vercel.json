{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/publicar-contenido.mjs --vercel",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/daily-content.js", "destination": "/api?route=daily-content.js" },
    { "source": "/api/auth/:accion", "destination": "/api?route=auth/:accion" },
    { "source": "/api/:route", "destination": "/api?route=:route" }
  ],
  "functions": {
    "api/index.mjs": { "includeFiles": "{dist/questions.json,dist/categories.js,content/banco-base.json,content/archivo/*.json}", "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/generar-dia", "schedule": "30 23 * * *" }
  ]
}
